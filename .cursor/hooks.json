{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 scripts/agent-hooks/guard-shell.py",
        "matcher": "pulumi|git|aws|prod|truth|--live",
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 scripts/agent-hooks/format-python.py",
        "timeout": 60
      }
    ]
  }
}
