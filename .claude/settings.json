{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(make format)",
      "Bash(make lint:*)",
      "Bash(black:*)",
      "Bash(isort:*)",
      "Bash(npm run lint)",
      "Bash(npm run type-check)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(rg:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(pulumi destroy:*)",
      "Bash(pulumi stack rm:*)",
      "Bash(pulumi stack select prod:*)",
      "Bash(pulumi stack select tnorlund/portfolio/prod:*)",
      "Bash(scripts/promote_dev_to_prod.sh:*)",
      "Bash(scripts/start_ingestion_prod.sh:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)"
    ],
    "ask": [
      "Bash(pulumi up:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/agent-hooks/guard-shell.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/agent-hooks/format-python.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
